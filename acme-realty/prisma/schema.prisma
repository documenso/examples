generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id           String   @id @default(cuid())
  property     String
  price        String
  buyerName    String
  sellerName   String
  buyerEmail   String?
  sellerEmail  String?
  buyerToken   String?
  buyerSigned  Boolean  @default(false)
  sellerToken  String?
  sellerSigned Boolean  @default(false)
  documentId   String?
  createdAt    DateTime @default(now())
}
