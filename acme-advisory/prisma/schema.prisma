generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClientSession {
  id            String   @id @default(cuid())
  clientName    String
  email         String
  aum           String
  fee           String
  pipelineStage String   @default("prospect")
  imaToken      String?
  imaSigned     Boolean  @default(false)
  feeToken      String?
  feeSigned     Boolean  @default(false)
  advToken      String?
  advSigned     Boolean  @default(false)
  createdAt     DateTime @default(now())
}
